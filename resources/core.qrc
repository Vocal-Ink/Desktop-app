<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/overlay">
        <file alias="index.html">overlay/index.html</file>
        <file alias="overlay.css">overlay/overlay.css</file>
        <file alias="overlay.js">overlay/overlay.js</file>
    </qresource>
    <qresource prefix="/predict">
        <file alias="en-words.tsv">predict/en-words.tsv</file>
        <file alias="en-bigrams.tsv">predict/en-bigrams.tsv</file>
        <file alias="en-trigrams.tsv">predict/en-trigrams.tsv</file>
    </qresource>
</RCC>
