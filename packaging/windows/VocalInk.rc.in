#include <winver.h>

IDI_ICON1 ICON "@PROJECT_SOURCE_DIR@/resources/icons/VocalInk.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@VOCALINK_ORG_NAME@"
            VALUE "FileDescription", "@VOCALINK_DISPLAY_NAME@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "VocalInk"
            VALUE "LegalCopyright", "Apache License 2.0"
            VALUE "OriginalFilename", "VocalInk.exe"
            VALUE "ProductName", "@VOCALINK_DISPLAY_NAME@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
