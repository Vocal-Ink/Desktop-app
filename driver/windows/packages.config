<?xml version="1.0" encoding="utf-8"?>
<!-- The WDK as NuGet packages (the supported way to build drivers without the WDK installer).
     Restore with: nuget restore driver\windows\packages.config -PackagesDirectory driver\windows\packages
     Keep the versions equal here and in Directory.Build.props. -->
<packages>
  <package id="Microsoft.Windows.SDK.CPP" version="10.0.26100.6584" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.x64" version="10.0.26100.6584" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.x64" version="10.0.26100.6584" targetFramework="native" />
</packages>
